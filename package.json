{
  "name": "@proofcan/c2pa-check",
  "version": "0.1.0",
  "description": "Read C2PA Content Credentials in an image, in the browser. The file never leaves the device. No trust-list check.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./c2pa.wasm": "./dist/c2pa.wasm"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/run.mjs",
    "scan": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "@contentauth/c2pa-web": "0.15.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2"
  }
}
